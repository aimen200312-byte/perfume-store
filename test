<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>دار المِسك والعود | عطور عربية أصيلة</title>
<meta name="theme-color" content="#120f0d">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;500;600;700;800&family=Amiri:wght@400;700&display=swap" rel="stylesheet">

<style>
:root {
    --black: #120f0d;
    --black2: #211815;
    --gold: #d4af37;
    --gold-light: #f1d878;
    --burgundy: #681d2d;
    --cream: #fbf6ed;
    --green: #25D366;
}

* { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; }

body {
    font-family: "Cairo", Tahoma, Arial, sans-serif;
    background: var(--cream);
    color: #222;
}

body.modal-open { overflow: hidden; }

/* شاشة الترحيب */
.welcome-screen {
    position: fixed;
    inset: 0;
    z-index: 99999;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: radial-gradient(circle at center, #30231c, #18120f 45%, #0c0908);
    color: white;
    transition: opacity .7s, visibility .7s;
}

.welcome-screen.hide {
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
}

.welcome-content {
    position: relative;
    z-index: 2;
    padding: 20px;
    animation: welcomeFade 1s ease;
}

@keyframes welcomeFade {
    from { opacity: 0; transform: translateY(-25px); }
    to { opacity: 1; transform: translateY(0); }
}

.welcome-circle {
    position: absolute;
    width: 350px;
    height: 350px;
    border: 1px solid rgba(212,175,55,.2);
    border-radius: 50%;
    animation: pulse 4s infinite ease-in-out;
}

.welcome-circle::before {
    content: "";
    position: absolute;
    inset: 25px;
    border: 1px solid rgba(212,175,55,.12);
    border-radius: 50%;
}

@keyframes pulse {
    0%, 100% { transform: scale(1); opacity: .5; }
    50% { transform: scale(1.08); opacity: 1; }
}

.welcome-small { color: var(--gold-light); font-size: 13px; margin-bottom: 15px; }
.welcome-brand { font-family: "Amiri", serif; color: var(--gold); font-size: clamp(38px,8vw,70px); font-weight: bold; }
.welcome-subtitle { color: #eee; margin-top: 12px; }
.welcome-line { width: 120px; height: 1px; margin: 25px auto; background: linear-gradient(90deg,transparent,var(--gold),transparent); }
.welcome-loading { color: #aaa; font-size: 12px; }
.welcome-loader { width: 170px; height: 3px; margin: 14px auto 0; background: #333; border-radius: 20px; overflow: hidden; }
.welcome-loader-bar { height: 100%; background: linear-gradient(90deg,#a37b08,#f1d878,#d4af37); animation: loading 1.5s linear forwards; }
@keyframes loading { from { width: 0; } to { width: 100%; } }
.welcome-footer { position: absolute; bottom: 25px; color: #777; font-size: 11px; }

/* الهيدر */
header {
    position: sticky;
    top: 0;
    z-index: 1000;
    min-height: 76px;
    padding: 10px 5%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: linear-gradient(135deg,var(--black),var(--black2));
    box-shadow: 0 5px 25px #0003;
}

.logo { text-align: center; cursor: pointer; }
.logo-main { font-family: "Amiri",serif; font-size: 29px; font-weight: bold; line-height: 1; color: var(--gold); }
.logo-sub { color: #eee; font-size: 10px; margin-top: 5px; }

.cart-button {
    border: none;
    background: var(--gold);
    color: #111;
    padding: 11px 16px;
    border-radius: 10px;
    font-family: inherit;
    font-weight: 800;
    cursor: pointer;
}

/* الواجهة الرئيسية */
.hero {
    min-height: 560px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 60px 20px;
    color: white;
    background: linear-gradient(rgba(18,15,13,.72),rgba(67,18,29,.80)),url("https://images.pexels.com/photos/36011542/pexels-photo-36011542.jpeg") center/cover;
}

.hero-content { max-width: 800px; }
.hero-small { color: var(--gold-light); font-weight: 700; margin-bottom: 15px; }
.hero h1 { font-family: "Amiri",serif; font-size: clamp(43px,7vw,75px); line-height: 1.15; }
.hero h2 { color: var(--gold-light); font-size: clamp(21px,3vw,30px); margin: 10px 0 20px; }
.hero p { max-width: 650px; margin: auto; color: #f5eee5; line-height: 2; }
.hero-btn { display: inline-block; margin-top: 28px; text-decoration: none; background: var(--gold); color: #111; padding: 13px 30px; border-radius: 10px; font-weight: 800; }

/* الأقسام */
.categories { padding: 55px 5% 25px; }
.section-heading { text-align: center; margin-bottom: 30px; }
.section-heading span { color: var(--burgundy); font-size: 14px; font-weight: 800; }
.section-heading h2 { font-family: "Amiri",serif; font-size: 38px; margin-top: 3px; }
.section-heading p { color: #777; }

.category-grid {
    max-width: 1100px;
    margin: auto;
    display: grid;
    grid-template-columns: repeat(2,1fr);
    gap: 22px;
}

.category-card {
    min-height: 270px;
    position: relative;
    display: flex;
    align-items: flex-end;
    padding: 25px;
    overflow: hidden;
    border-radius: 18px;
    color: white;
    background-position: center;
    background-size: cover;
}

.category-card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(transparent 10%,rgba(0,0,0,.85));
}

.men { background-image: url("https://images.unsplash.com/photo-1608828201317-ce72715cb12a?q=80&w=1974&auto=format&fit=crop"); }
.women { background-image: url("https://cdn.salla.sa/pywvq/BWU4qHdvP5GBoZ2jneU06kQ6Ud7QH3Z4MX0XO2Wo.jpg"); }
.category-content { position: relative; z-index: 2; }
.category-content h3 { font-family: "Amiri",serif; font-size: 31px; }
.category-content p { color: #eee; margin: 4px 0 13px; font-size: 13px; }
.category-content button { border: none; background: var(--gold); color: #111; padding: 8px 15px; border-radius: 8px; font-family: inherit; font-weight: 800; cursor: pointer; }

/* المنتجات */
.products-section { padding: 50px 5%; }
.product-category { margin-bottom: 60px; }
.product-title { display: flex; align-items: center; gap: 12px; margin-bottom: 22px; }
.product-title h2 { font-family: "Amiri",serif; font-size: 32px; white-space: nowrap; }
.product-title-line { height: 2px; flex: 1; background: linear-gradient(90deg,transparent,var(--gold)); }
.products { display: grid; grid-template-columns: repeat(auto-fit,minmax(230px,1fr)); gap: 20px; }

.product {
    background: white;
    border-radius: 15px;
    overflow: hidden;
    box-shadow: 0 5px 20px #0001;
    transition: .25s;
}

.product:hover { transform: translateY(-5px); box-shadow: 0 12px 30px #0002; }
.product-image { position: relative; overflow: hidden; }
.product-image img { width: 100%; height: 255px; object-fit: cover; display: block; cursor: pointer; transition: transform .35s; }
.product-image img:hover { transform: scale(1.05); }

.badge { position: absolute; top: 9px; right: 9px; background: var(--burgundy); color: white; padding: 4px 9px; border-radius: 20px; font-size: 10px; font-weight: bold; pointer-events: none; }
.product-info { padding: 14px; }
.product-info h3 { font-size: 18px; margin-bottom: 5px; }
.description { color: #777; font-size: 12px; line-height: 1.7; min-height: 42px; }
.price { color: #a37b08; font-size: 19px; font-weight: 800; margin: 11px 0; }
.add-btn { width: 100%; border: none; padding: 10px 7px; background: var(--black); color: white; border-radius: 8px; font-family: inherit; font-size: 13px; font-weight: 700; cursor: pointer; }
.add-btn:hover { background: var(--gold); color: #111; }

/* نافذة تفاصيل العطر */
.perfume-modal {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 18px;
    background: rgba(0,0,0,.8);
    backdrop-filter: blur(5px);
}

.perfume-modal.active { display: flex; }

.perfume-modal-content {
    position: relative;
    width: min(850px,100%);
    max-height: 92vh;
    overflow-y: auto;
    background: var(--cream);
    border: 1px solid var(--gold);
    border-radius: 18px;
    box-shadow: 0 15px 60px #0008;
    animation: modalShow .3s ease;
}

@keyframes modalShow {
    from { opacity: 0; transform: translateY(20px) scale(.97); }
    to { opacity: 1; transform: translateY(0) scale(1); }
}

.perfume-close {
    position: absolute;
    top: 12px;
    left: 12px;
    z-index: 3;
    width: 40px;
    height: 40px;
    border: none;
    border-radius: 50%;
    background: var(--black);
    color: var(--gold-light);
    font-size: 26px;
    cursor: pointer;
}

.perfume-modal-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 25px;
    padding: 28px;
    align-items: center;
}

.perfume-modal-image {
    width: 100%;
    height: 380px;
    object-fit: contain;
    background: white;
    border-radius: 12px;
}

.perfume-modal-info h2 {
    font-family: "Amiri",serif;
    font-size: 32px;
    color: var(--burgundy);
    margin-bottom: 10px;
}

.perfume-modal-description { color: #666; font-size: 14px; line-height: 2; margin-bottom: 15px; }

.perfume-details { list-style: none; margin: 15px 0; }
.perfume-details li { padding: 10px 0; border-bottom: 1px solid #e5dccb; font-size: 13px; line-height: 1.8; }
.perfume-details strong { color: var(--burgundy); }
.perfume-modal-price { color: #a37b08; font-size: 26px; font-weight: 800; margin: 18px 0; }

.perfume-modal-add {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 9px;
    background: var(--black);
    color: var(--gold-light);
    font-family: inherit;
    font-weight: 800;
    font-size: 14px;
    cursor: pointer;
}

.perfume-modal-add:hover { background: var(--gold); color: #111; }

/* الإشعار */
.toast {
    position: fixed;
    left: 50%;
    bottom: 20px;
    transform: translate(-50%,100px);
    opacity: 0;
    z-index: 20000;
    background: var(--black);
    color: white;
    padding: 12px 20px;
    border-radius: 10px;
    font-size: 13px;
    transition: .3s;
    max-width: 90%;
    text-align: center;
}

.toast.show { opacity: 1; transform: translate(-50%,0); }

/* السلة */
.cart-overlay { position: fixed; inset: 0; background: #000a; display: none; z-index: 5000; }
.cart-overlay.active { display: block; }
.cart { position: absolute; top: 0; right: 0; width: min(500px,100%); height: 100%; background: white; padding: 22px; overflow-y: auto; }
.cart-header { display: flex; align-items: center; justify-content: space-between; padding-bottom: 15px; border-bottom: 1px solid #eee; }
.close-cart { width: 38px; height: 38px; border: none; border-radius: 50%; background: #eee; font-size: 20px; cursor: pointer; }
.cart-item { padding: 15px 0; border-bottom: 1px solid #eee; }
.cart-item-row { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 9px; }
.quantity { display: flex; align-items: center; gap: 7px; }
.quantity button { width: 29px; height: 29px; border: none; border-radius: 6px; background: #eee; cursor: pointer; }
.remove-btn { border: none; background: transparent; color: #c62828; cursor: pointer; font-family: inherit; }
.empty-cart { text-align: center; color: #777; padding: 40px 10px; }
.order-summary { margin-top: 20px; border-top: 1px solid #ddd; padding-top: 15px; }
.summary-row { display: flex; justify-content: space-between; margin-bottom: 9px; }
.summary-total { color: #a37b08; font-size: 21px; font-weight: 800; margin-top: 13px; }

/* بيانات الطلب */
.order-form { margin-top: 20px; border-top: 1px solid #eee; padding-top: 20px; }
.order-form h3 { margin-bottom: 13px; }
.order-form input, .order-form textarea, .order-form select {
    width: 100%;
    padding: 12px;
    margin-bottom: 10px;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-family: inherit;
    font-size: 14px;
    outline: none;
}
.order-form input:focus, .order-form textarea:focus, .order-form select:focus { border-color: var(--gold); }
.order-form textarea { min-height: 80px; resize: vertical; }

.delivery-location-note {
    background: linear-gradient(135deg,#fff9df,#fff4c7);
    border: 1px solid #e8d58b;
    color: #66520b;
    padding: 13px;
    border-radius: 9px;
    font-size: 12px;
    line-height: 1.9;
    margin: 5px 0 14px;
}

.whatsapp-btn { width: 100%; border: none; background: var(--green); color: white; padding: 14px; border-radius: 9px; font-family: inherit; font-size: 15px; font-weight: 800; cursor: pointer; }
.whatsapp-btn:hover { background: #1ebe5d; }

/* الفوتر */
footer { background: var(--black); color: #ddd; text-align: center; padding: 30px 15px; margin-top: 20px; font-size: 13px; }
footer strong { color: var(--gold); }

/* الهاتف */
@media (max-width: 700px) {
    header { min-height: 67px; padding: 9px 4%; }
    .logo-main { font-size: 22px; }
    .logo-sub { font-size: 8px; }
    .cart-button { padding: 9px 11px; font-size: 12px; }
    .hero { min-height: 500px; padding: 45px 15px; }
    .hero h1 { font-size: 42px; }
    .hero h2 { font-size: 20px; }
    .hero p { font-size: 14px; }
    .categories { padding: 40px 4% 15px; }
    .category-grid { grid-template-columns: 1fr; }
    .category-card { min-height: 210px; }
    .products-section { padding: 35px 3.5%; }
    .products { grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px; }
    .product { border-radius: 11px; }
    .product-image img { height: 165px; }
    .product-info { padding: 9px; }
    .product-info h3 { font-size: 14px; }
    .description { font-size: 10px; line-height: 1.55; min-height: 36px; }
    .price { font-size: 16px; margin: 8px 0; }
    .add-btn { font-size: 11px; padding: 9px 4px; }
    .badge { font-size: 8px; padding: 3px 7px; }
    .product-title h2 { font-size: 27px; }
    .cart { padding: 18px; }
    .welcome-circle { width: 270px; height: 270px; }
    .welcome-loader { width: 140px; }

    .perfume-modal { padding: 10px; }
    .perfume-modal-content { max-height: 94vh; }
    .perfume-modal-body { grid-template-columns: 1fr; gap: 12px; padding: 18px; }
    .perfume-modal-image { height: 220px; }
    .perfume-modal-info h2 { font-size: 26px; }
    .perfume-modal-description { font-size: 13px; }
}

@media (max-width: 360px) {
    .products { gap: 7px; }
    .product-image img { height: 145px; }
    .product-info h3 { font-size: 13px; }
    .description { font-size: 9px; }
    .price { font-size: 15px; }
    .add-btn { font-size: 10px; }
}
</style>
</head>

