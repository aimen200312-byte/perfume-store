            <select id="customerCity" onchange="updateDelivery()">
                <option value="">اختر المدينة</option>
                <option value="طرابلس">طرابلس</option>
                <option value="ضواحي طرابلس">ضواحي طرابلس</option>
                <option value="بنغازي">بنغازي</option>
                <option value="مصراتة">مصراتة</option>
                <option value="الزاوية">الزاوية</option>
                <option value="زليتن">زليتن</option>
                <option value="الخمس">الخمس</option>
                <option value="سبها">سبها</option>
                <option value="مدينة أخرى">مدينة أخرى</option>
            </select>

            <textarea id="customerAddress" placeholder="العنوان بالتفصيل"></textarea>
            <textarea id="customerNotes" placeholder="ملاحظات إضافية (اختياري)"></textarea>

            <div class="delivery-location-note">
                📍 <strong>موقع التسليم</strong><br>
                بعد إرسال الطلب عبر واتساب، يرجى إرسال موقع المكان الذي ترغب باستلام طلبك فيه. يمكن أن يكون المنزل أو العمل أو أي مكان آخر مناسب للتسليم.
            </div>

            <button class="whatsapp-btn" onclick="sendToWhatsApp()">📱 تأكيد الطلب وإرساله عبر واتساب</button>
