    <p>جميع الحقوق محفوظة © 2026 <strong>دار المِسك والعود</strong></p>
    <p>عطور عربية أصيلة</p>
</footer>

<script>
"use strict";

/* إعدادات المتجر */
const whatsappNumber = "218911304841";
const TRIPOLI_DELIVERY = 20;

/* بيانات تفاصيل العطور */
const perfumeDetails = {
    "خمرة قهوة": {
        category: "رجالي",
        size: "تحقق من حجم العبوة المتوفر",
        notes: "القهوة والتوابل والنفحات الدافئة",
        occasion: "السهرات والأجواء الباردة",
        description: "عطر شرقي دافئ وفاخر يجمع بين حلاوة التوابل ولمسة القهوة الغنية ليمنحك حضورًا جذابًا ومميزًا."
    },
    "فخر لطافة": {
        category: "رجالي",
        size: "100 مل بحسب المنتج المعروض",
        notes: "نفحات منعشة وزهرية ودافئة",
        occasion: "الاستخدام اليومي والمناسبات",
        description: "عطر أنيق وعصري يجمع بين الانتعاش والنظافة مع لمسة دافئة وجذابة."
    },
    "9PM Night Out": {
        category: "رجالي",
        size: "تحقق من حجم العبوة المتوفر",
        notes: "نفحات حلوة وفاكهية ودافئة",
        occasion: "السهرات والمناسبات",
        description: "رائحة أنيقة وجذابة بلمسة دافئة وفاخرة، مثالية للسهرات والمناسبات."
    },
    "Supremacy Collector's Edition": {
        category: "رجالي",
        size: "100 ml    ",
        notes: "نفحات فاكهية وخشبية ودخانية",
        occasion: "المناسبات والاستخدام المسائي",
        description: "عطر فخم وجريء يبدأ بانتعاش فاكهي جذاب، ثم يتحول إلى نفحات خشبية ودخانية عميقة."
    },
    "Purple Heart Diamond": {
        category: "نسائي",
        size: "تحقق من حجم العبوة المتوفر",
        notes: "طابع أنثوي ناعم وأنيق",
        occasion: "المناسبات والاستخدام اليومي",
        description: "عطر أنثوي فاخر يجمع بين الأناقة والجاذبية في تركيبة ناعمة ومميزة."
    },
    "Club de Nuit Woman": {
        category: "نسائي",
        size: "تحقق من حجم العبوة المتوفر",
        notes: "البرغموت والخوخ والبرتقال والياسمين والورد والمسك والفانيليا",
        occasion: "الاستخدام اليومي والمناسبات",
        description: "عطر زهري وفاكهي أنيق بلمسات من الحمضيات والزهور والمسك والفانيليا."
    },
    "Lattafa Yara": {
        category: "نسائي",
        size: "100 مل بحسب المنتج المعروض",
        notes: "الفانيليا والنفحات الفاكهية والزهرية",
        occasion: "الاستخدام اليومي والمناسبات",
        description: "عطر حلو وناعم وأنثوي، يجمع بين النفحات الفاكهية والزهرية ولمسة كريمية."
    },
    "MISS SAKURA": {
        category: "نسائي",
        size: "تحقق من حجم العبوة المتوفر",
        notes: "زهرة الكرز والياسمين والمسك",
        occasion: "الاستخدام اليومي",
        description: "عطر ناعم ومنعش مستوحى من زهرة الكرز مع لمسات زهرية ومسك نظيف."
    }
};

/* شاشة الترحيب */
window.addEventListener("load", function() {
    setTimeout(function() {
        document.getElementById("welcomeScreen").classList.add("hide");
    }, 1500);
});

/* حفظ السلة */
function readSavedCart() {
    try {
        const saved = JSON.parse(localStorage.getItem("darAlMiskCart") || "[]");
        if (!Array.isArray(saved)) return [];
        return saved.filter(item =>
            item &&
            typeof item.name === "string" &&
            Number.isFinite(Number(item.price)) &&
            Number(item.price) >= 0 &&
            Number.isInteger(Number(item.quantity)) &&
            Number(item.quantity) > 0
        ).map(item => ({
            name: item.name,
            price: Number(item.price),
            quantity: Number(item.quantity)
        }));
    } catch {
        return [];
    }
}

let cart = readSavedCart();

function saveCart() {
    try {
        localStorage.setItem("darAlMiskCart", JSON.stringify(cart));
    } catch (error) {
        console.warn("تعذر حفظ السلة في المتصفح.", error);
    }
}

/* إضافة منتج */
function addToCart(name, price) {
    const existing = cart.find(item => item.name === name);

    if (existing) {
        existing.quantity++;
    } else {
        cart.push({ name, price: Number(price), quantity: 1 });
    }

    saveCart();
    updateCart();
    showToast("✓ تمت إضافة " + name + " إلى السلة");
}

/* الإشعار */
let toastTimer;

function showToast(message) {
    const toast = document.getElementById("toast");
    toast.textContent = message;
    toast.classList.add("show");

    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => toast.classList.remove("show"), 2300);
}

/* فتح تفاصيل العطر */
function openPerfumeDetails(name, price, image, category) {
    const details = perfumeDetails[name] || {
        category: category || "غير محدد",
        size: "يرجى التأكد من حجم العبوة",
        notes: "يرجى الاستفسار عن المكونات",
        occasion: "حسب تفضيلك",
        description: "اكتشف تفاصيل هذا العطر."
    };

    document.getElementById("modalPerfumeName").textContent = name;

    const modalImage = document.getElementById("modalPerfumeImage");
    modalImage.src = image;
    modalImage.alt = name;

    document.getElementById("modalPerfumeDescription").textContent = details.description;
    document.getElementById("modalPerfumeCategory").textContent = details.category;
    document.getElementById("modalPerfumeSize").textContent = details.size;
    document.getElementById("modalPerfumeNotes").textContent = details.notes;
    document.getElementById("modalPerfumeOccasion").textContent = details.occasion;
    document.getElementById("modalPerfumePrice").textContent = price + " د.ل";

    document.getElementById("modalAddButton").onclick = function() {
        addToCart(name, price);
    };

    document.getElementById("perfumeModal").classList.add("active");
    document.body.classList.add("modal-open");
}

function closePerfumeModal(event) {
    if (event && event.target.id !== "perfumeModal") return;

    document.getElementById("perfumeModal").classList.remove("active");
    document.body.classList.remove("modal-open");
}

/* ربط الصور تلقائيًا ببيانات المنتجات */
document.querySelectorAll(".product").forEach(function(product) {
    const image = product.querySelector(".product-image img");
    const nameElement = product.querySelector(".product-info h3");
    const priceElement = product.querySelector(".price");
    const badge = product.querySelector(".badge");

    if (!image || !nameElement || !priceElement) return;

    const name = nameElement.textContent.trim();
    const price = Number(priceElement.textContent.replace(/[^\d.]/g, ""));
    const category = badge ? badge.textContent.trim() : "";

    image.tabIndex = 0;
    image.setAttribute("role", "button");
    image.setAttribute("aria-label", "عرض تفاصيل " + name);

    function showDetails() {
        openPerfumeDetails(name, price, image.src, category);
    }

    image.addEventListener("click", showDetails);
    image.addEventListener("keydown", function(event) {
        if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            showDetails();
        }
    });
});

/* إغلاق النافذة بزر Escape */
document.addEventListener("keydown", function(event) {
    if (event.key === "Escape") {
        closePerfumeModal();
        closeCart();
    }
});

/* تحديث السلة */
function updateCart() {
    const container = document.getElementById("cartItems");
    container.replaceChildren();

    let total = 0;
    let count = 0;

    if (cart.length === 0) {
        const empty = document.createElement("div");
        empty.className = "empty-cart";
        empty.textContent = "🛍️ السلة فارغة. اختر عطرك المفضل وأضفه إلى السلة.";
        container.appendChild(empty);
    }

    cart.forEach(function(item, index) {
        const itemTotal = item.price * item.quantity;
        total += itemTotal;
        count += item.quantity;

        const div = document.createElement("div");
        div.className = "cart-item";

        const title = document.createElement("strong");
        title.textContent = item.name;
        div.appendChild(title);

        const row = document.createElement("div");
        row.className = "cart-item-row";

        const quantity = document.createElement("div");
        quantity.className = "quantity";

        const minus = document.createElement("button");
        minus.type = "button";
        minus.textContent = "−";
        minus.setAttribute("aria-label", "تقليل كمية " + item.name);
        minus.addEventListener("click", () => changeQuantity(index, -1));

        const number = document.createElement("span");
        number.textContent = item.quantity;

        const plus = document.createElement("button");
        plus.type = "button";
        plus.textContent = "+";
        plus.setAttribute("aria-label", "زيادة كمية " + item.name);
        plus.addEventListener("click", () => changeQuantity(index, 1));

        quantity.append(minus, number, plus);

        const subtotal = document.createElement("strong");
        subtotal.textContent = itemTotal + " د.ل";

        const remove = document.createElement("button");
        remove.type = "button";
        remove.className = "remove-btn";
        remove.textContent = "حذف";
        remove.addEventListener("click", () => removeItem(index));

        row.append(quantity, subtotal, remove);
        div.appendChild(row);
        container.appendChild(div);
    });

    document.getElementById("cartCount").textContent = count;
    document.getElementById("productsTotal").textContent = total;

    updateDelivery();
}

function changeQuantity(index, amount) {
    if (!cart[index]) return;

    cart[index].quantity += amount;

    if (cart[index].quantity <= 0) {
        cart.splice(index, 1);
    }

    saveCart();
    updateCart();
}

function removeItem(index) {
    if (index < 0 || index >= cart.length) return;
    cart.splice(index, 1);
    saveCart();
    updateCart();
}

/* فتح وإغلاق السلة */
function openCart() {
    document.getElementById("cartOverlay").classList.add("active");
    document.body.classList.add("modal-open");
    updateCart();
}

function closeCart() {
    document.getElementById("cartOverlay").classList.remove("active");
    if (!document.getElementById("perfumeModal").classList.contains("active")) {
        document.body.classList.remove("modal-open");
    }
}

/* التوصيل */
function updateDelivery() {
    const city = document.getElementById("customerCity").value;
    const localCity = city === "طرابلس" || city === "ضواحي طرابلس";
    const productsTotal = cart.reduce((sum, item) => sum + item.price * item.quantity, 0);

    document.getElementById("deliveryPrice").textContent =
        localCity ? TRIPOLI_DELIVERY + " د.ل" : city ? "على الخاص" : "اختر المدينة";

    document.getElementById("cartTotal").textContent =
        (productsTotal + (localCity ? TRIPOLI_DELIVERY : 0)) + " د.ل";
}

/* إرسال الطلب إلى واتساب */
function sendToWhatsApp() {
    if (cart.length === 0) {
        alert("السلة فارغة، أضف عطرًا أولًا.");
        return;
    }

    const name = document.getElementById("customerName").value.trim();
    const phone = document.getElementById("customerPhone").value.trim();
    const city = document.getElementById("customerCity").value;
    const address = document.getElementById("customerAddress").value.trim();
    const notes = document.getElementById("customerNotes").value.trim();

    if (!name || !phone || !city || !address) {
        alert("يرجى إدخال الاسم ورقم الهاتف والمدينة والعنوان.");
        return;
    }

    let productsTotal = 0;
    let message = "🛍️ *طلب جديد من دار المِسك والعود*\n\n";

    message += "👤 *اسم العميل:* " + name + "\n";
    message += "📞 *رقم الهاتف:* " + phone + "\n";
    message += "📍 *المدينة:* " + city + "\n";
    message += "🏠 *العنوان:* " + address + "\n";

    if (notes) message += "📝 *ملاحظات:* " + notes + "\n";

    message += "\n🧴 *المنتجات:*\n";

    cart.forEach(function(item) {
        const itemTotal = item.price * item.quantity;
        productsTotal += itemTotal;
        message += "• " + item.name + " × " + item.quantity + " = " + itemTotal + " د.ل\n";
    });

    message += "\n💵 *قيمة المنتجات:* " + productsTotal + " د.ل\n";

    if (city === "طرابلس" || city === "ضواحي طرابلس") {
        message += "🚚 *التوصيل:* " + TRIPOLI_DELIVERY + " د.ل\n";
        message += "💰 *الإجمالي:* " + (productsTotal + TRIPOLI_DELIVERY) + " د.ل\n";
    } else {
        message += "🚚 *التوصيل:* بالتنسيق مع المكتب\n";
        message += "💰 *الإجمالي:* " + productsTotal + " د.ل + تكلفة التوصيل\n";
    }

    message += "\n📍 *موقع التسليم:*\nيرجى إرسال موقع المكان الذي ترغب باستلام الطلب فيه عبر واتساب بعد إرسال هذه الرسالة.";

    const whatsappURL = "https://wa.me/" + whatsappNumber + "?text=" + encodeURIComponent(message);
    window.open(whatsappURL, "_blank", "noopener,noreferrer");
}

/* الانتقال إلى قسم المنتجات */
function scrollToProducts(id) {
    const section = document.getElementById(id);
    if (section) section.scrollIntoView({ behavior: "smooth" });
}

/* تشغيل السلة عند تحميل الصفحة */
updateCart();
</script>

